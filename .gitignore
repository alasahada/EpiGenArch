# Never commit individual-level or restricted data
*.bed
*.bim
*.fam
*.pgen
*.pvar
*.psam
*.bgen
*.sample
*.vcf
*.vcf.gz
*.eigenvec
*.sscore
*.rds
*.RData
*.gz
*.csv
*.tsv
.DS_Store

# Input and generated-result directories used by these examples
/data/*
/genotypes/
/phenotypes/
/samples/
/weights/
/external/
/lead_snps/
/gwas/
/scores/
/saige/
/grm/
/greml/
/ldsc/
/results/
/outputs/

# Local configuration, credentials, logs and session files
.env
.env.*
*.pem
*.key
*.log
.Rhistory
.Ruserdata
.Rproj.user/
__pycache__/

# Ignore rules are a convenience, not a substitute for checking staged files.

# Synthetic figure examples intentionally included in the public repository
!/data/README.md
!/data/figure1a_example.csv
!/data/figure1b_example.csv
!/data/figure2_ddd_example.csv
!/data/figure2_gel_example.csv
!/data/figure3_example.csv
!/data/figure4a_example.csv
!/data/figure4b_example.csv
